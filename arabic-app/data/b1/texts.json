brá un descuento para estudiantes y personas mayores."]},"questions":[{"q":{"es":"¿Qué se va a inaugurar?"},"options":["مَطَار جَدِيد","خَطّ مِتْرُو جَدِيد","مُسْتَشْفًى"],"answer":1},{"q":{"es":"¿Cuántos pasajeros al día espera el ministro?"},"options":["مِئَة أَلْف","مَلْيُون","عَشَرَة آلَاف"],"answer":0}],"gaps":{"items":[],"distractors":[]},"tok":[[[["أَعْلَنَتْ",[["أَعْلَنَتْ",null]],"يُعْلِنُ"],[" ",[[" ",null]],null],["وِزَارَةُ",[["وِزَارَةُ",null]],"وِزَارَة"],[" ",[[" ",null]],null],["النَّقْل",[["النَّقْل",null]],"نَقْل"],[" ",[[" ",null]],null],["أَمْسِ",[["أَمْسِ",null]],"أَمْس"],[" ",[[" ",null]],null],["أَنَّ",[["أَنَّ",null]],"أَنَّ"],[" ",[[" ",null]],null],["خَطَّ",[["خَطَّ",null]],"خَطّ"],[" ",[[" ",null]],null],["المِتْرُو",[["المِتْرُو",null]],"مِتْرُو"],[" ",[[" ",null]],null],["الجَدِيد",[["الجَدِيد",null]],"جَدِيد"],[" ",[[" ",null]],null],["سَيُفْتَتَحُ",[["سَيُفْتَتَحُ",null]],"يُفْتَتَحُ"],[" ",[[" ",null]],null],["فِي",[["فِي",null]],"فِي"],[" ",[[" ",null]],null],["بِدَايَةِ",[["بِدَايَةِ",null]],"بِدَايَة"],[" ",[[" ",null]],null],["السَّنَة",[["السَّنَة",null]],"سَنَة"],[" ",[[" ",null]],null],["القَادِمَة",[["القَادِمَة",null]],"القَادِم"],[".",[[".",null]],null]],[["وَقَالَ",[["وَقَالَ",null]],"قَالَ"],[" ",[[" ",null]],null],["الوَزِير",[["الوَزِير",null]],"وَزِير"],[" ",[[" ",null]],null],["فِي",[["فِي",null]],"فِي"],[" ",[[" ",null]],null],["مُؤْتَمَر",[["مُؤْتَمَر",null]],"مُؤْتَمَر صَحَفِيّ"],[" ",[[" ",null]],null],["صَحَفِيّ",[["صَحَفِيّ",null]],"صَحَفِيّ"],[" ",[[" ",null]],null],["إِنَّ",[["إِنَّ",null]],"إِنَّ"],[" ",[[" ",null]],null],["المَشْرُوع",[["المَشْرُوع",null]],"مَشْرُوع"],[" ",[[" ",null]],null],["كَلَّفَ",[["كَلَّفَ",null]],"يُكَلِّفُ"],[" ",[[" ",null]],null],["أَكْثَرَ",[["أَكْثَرَ",null]],"أَكْثَر"],[" ",[[" ",null]],null],["مِنْ",[["مِنْ",null]],"مِنْ"],[" ",[[" ",null]],null],["مِلْيَارَيْ",[["مِلْيَارَيْ",null]],"مِلْيَار"],[" ",[[" ",null]],null],["دُولَار",[["دُولَار",null]],"دُولَار"],[".",[[".",null]],