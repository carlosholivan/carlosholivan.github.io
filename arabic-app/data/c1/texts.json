[{"id":"c1-t1","level":"c1","order":1,"unit":1,"title":{"ar":"أَبُو عِلْمِ الاِجْتِمَاعِ","ja":"أَبُو عِلْمِ الاِجْتِمَاعِ","es":"El padre de la sociología","en":"El padre de la sociología"},"summary":{"es":""},"paragraphs":["وُلِدَ عَبْدُ الرَّحْمٰنِ بْنُ خَلْدُونَ فِي تُونِسَ سَنَةَ ١٣٣٢، فِي أُسْرَةٍ أَنْدَلُسِيَّةِ الأَصْلِ.\nتَنَقَّلَ بَيْنَ بَلَاطَاتِ المَغْرِبِ وَالأَنْدَلُسِ وَمِصْرَ، فَعَمِلَ كَاتِبًا وَسَفِيرًا وَقَاضِيًا.\nغَيْرَ أَنَّ شُهْرَتَهُ إِنَّمَا تَعُودُ إِلَى «المُقَدِّمَةِ»، الَّتِي كَتَبَهَا مَدْخَلًا لِكِتَابِهِ فِي التَّارِيخِ.\nفِيهَا لَمْ يَكْتَفِ بِسَرْدِ الأَحْدَاثِ، بَلْ حَاوَلَ أَنْ يَكْتَشِفَ القَوَانِينَ الَّتِي تَحْكُمُ قِيَامَ الدُّوَلِ وَسُقُوطَهَا.\nوَاسْتَنْتَجَ أَنَّ «العَصَبِيَّةَ»، أَيِ التَّضَامُنَ بَيْنَ أَفْرَادِ الجَمَاعَةِ، هِيَ الَّتِي تُمَكِّنُ أَهْلَ البَادِيَةِ مِنْ تَأْسِيسِ الدَّوْلَةِ.\nثُمَّ يُضْعِفُ التَّرَفُ هٰذِهِ العَصَبِيَّةَ جِيلًا بَعْدَ جِيلٍ، فَمَا هِيَ إِلَّا ثَلَاثَةُ أَجْيَالٍ تَقْرِيبًا حَتَّى تَنْهَارَ الدَّوْلَةُ وَتَقُومَ غَيْرُهَا.\nلِذٰلِكَ يَعُدُّهُ كَثِيرٌ مِنَ البَاحِثِينَ رَائِدًا لِعِلْمِ الاِجْتِمَاعِ وَفَلْسَفَةِ التَّارِيخِ، قَبْلَ أَنْ يَظْهَرَ هٰذَانِ العِلْمَانِ فِي أُورُوبَّا بِقُرُونٍ."],"translation":{"es":["ʿAbd al‑Rahman ibn Jaldún nació en Túnez en 1332, en una familia de origen andalusí.\nRecorrió las cortes del Magreb, al‑Ándalus y Egipto, y fue secretario, embajador y juez.\nPero su fama se debe sobre todo a la «Muqaddima», que escribió como introducción a su obra de historia.\nEn ella no se limitó a narrar los hechos, sino que intentó descubrir las leyes que rigen el auge y la caída de los Estados.\nY concluyó que la «ʿaṣabiyya», es decir, la solidaridad entre los miembros del grupo, es lo que permite a los pueblos nómadas fundar un Estado.\nLuego el lujo debilita esa solidaridad generación tras generación, y en apenas unas tres generaciones el Estado se derrumba y surge otro.\nPor eso muchos investigadores lo consideran pionero de la sociología y de la filosofía de la historia, siglos antes de que estas disciplinas aparecieran en Europa."]},"questions":[{"q":{"es":"Según Ibn Jaldún, ¿qué causa la caída de las dinastías?"},"options":["التَّرَفُ وَضَعْفُ العَصَبِيَّةِ","الحُرُوبُ الخَارِجِيَّةُ فَقَطْ","قِلَّةُ المَالِ"],"answer":0},{"q":{"es":"¿Cuántas generaciones dura una dinastía según su teoría?"},"options":["جِيلٌ وَاحِدٌ","ثَلَاثَةُ أَجْيَالٍ تَقْرِيبًا","عَشَرَةُ أَجْيَالٍ"],"answer":1}],"gaps":{"items":[],"distractors":[]},"tok":[[[["وُلِدَ",[["وُلِدَ",null]],"وُلِدَ"],[" ",[[" ",null]],null],["عَبْدُ",[["عَبْدُ",null]],null],[" ",[[" ",null]],null],["الرَّحْمٰنِ",[["الرَّحْمٰنِ",null]],null],[" ",[[" ",null]],null],["بْنُ",[["بْنُ",null]],null],[" ",[[" ",null]],null],["خَلْدُونَ",[["خَلْدُونَ",null]],null],[" ",[[" ",null]],null],["فِي",[["فِي",null]],"فِي"],[" ",[[" ",null]],null],["تُونِسَ",[["تُونِسَ",null]],"تُونِس"],[" ",[[" ",null]],null],["سَنَةَ",[["سَنَةَ",null]],"سَنَة"],[" ١٣٣٢",[[" ١٣٣٢",null]],null],["،",[["،",null]],null],[" ",[[" ",null]],null],["فِي",[["فِي",null]],"فِي"],[" ",[[" ",null]],null],["أُسْرَةٍ",[["أُسْرَةٍ",null]],"سَرِير"],[" ",[[" ",null]],null],["أَنْدَلُسِيَّةِ",[["أَنْدَلُسِيَّةِ",null]],"أَنْدَلُسِيّ"],[" ",[[" ",null]],null],["الأَصْلِ",[["الأَصْلِ",null]],"يَصِلُ"],[".",[[".",null]],null]],[["تَنَقَّلَ",[["تَنَقَّلَ",null]],"يَنْقُلُ"],[" ",[[" ",null]],null],["بَيْنَ",[["بَيْنَ",null]],"بَيْنَ"],[" ",[[" ",null]],null],["بَلَاطَاتِ",[["بَلَاطَاتِ",null]],"بَلَاط"],[" ",[[" ",null]],null],["المَغْرِبِ",[["المَغْرِبِ",null]],"المَغْرِب"],[" ",[[" ",null]],null],["وَالأَنْدَلُسِ",[["وَالأَنْدَلُسِ",null]],"الأَنْدَلُس"],[" ",[[" ",null]],null],["وَمِصْرَ",[["وَمِصْرَ",null]],"مِصْر"],["،",[["،",null]],null],[" ",[[" ",null]],null],["فَعَمِلَ",[["فَعَمِلَ",null]],"عَمَل"],[" ",[[" ",null]],null],["كَاتِبًا",[["كَاتِبًا",null]],"كَاتِب"],[" ",[[" ",null]],null],["وَسَفِيرًا",[["وَسَفِيرًا",null]],"سَفِير"],[" ",[[" ",null]],null],["وَقَاضِيًا",[["وَقَاضِيًا",null]],"قَاضٍ"],[".",[[".",null]],n