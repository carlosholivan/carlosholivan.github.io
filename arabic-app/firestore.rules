rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Private progress: each user only reads/writes their own document.
    match /users/{uid} {
      allow read, write: if verified() && request.auth.uid == uid;
    }
    // Japanese app public ranking: same rules as the Chinese one.
    match /ranking_arabe/{uid} {
      allow read: if verified();
      allow delete: if verified() && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'words', 'mastered', 'lessons', 'sets', 'streak', 't'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 200000;
    }
    // Chinese app public ranking: every verified user can read it; each user only writes their own entry.
    match /ranking_chino/{uid} {
      allow read: if verified();
      allow delete: if verified() && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'words', 'mastered', 'lessons', 'sets', 'streak', 't'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 200000;
    }
  }
}
