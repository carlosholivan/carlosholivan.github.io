[{"id": "u1", "icon": "🔤", "title": {"de": "Hallo!", "es": "¡Hola!", "en": "Hello!"}, "desc": {"es": "Saludar, presentarse y despedirse; du y Sie", "en": "Greeting, introducing yourself and saying goodbye; du and Sie"}, "items": [{"q": "Hallo! Ich ___ Julia.", "o": ["heißt", "heiße", "heißen", "bist"], "a": 1, "tr": {"es": "¡Hola! Me llamo Julia.", "en": "Hello! My name is Julia."}, "e": {"es": "ich heiße", "en": "ich heiße"}}, {"q": "Wie ___ du?", "o": ["heißt", "heiße", "bin", "heißen"], "a": 0, "tr": {"es": "¿Cómo te llamas?", "en": "What's your name?"}, "e": {"es": "du heißt", "en": "du heißt"}}, {"q": "Wie heißen ___, bitte?", "o": ["er", "Sie", "ich", "du"], "a": 1, "tr": {"es": "¿Cómo se llama usted, por favor?", "en": "What is your name, please?"}, "e": {"es": "Sie heißen (formal)", "en": "Sie heißen (formal)"}}, {"q": "Ich ___ Tom. Und du?", "o": ["ist", "bin", "sind", "bist"], "a": 1, "tr": {"es": "Soy Tom. ¿Y tú?", "en": "I'm Tom. And you?"}, "e": {"es": "ich bin", "en": "ich bin"}}, {"q": "— Wie geht's? — ___, danke.", "o": ["Gut", "Hallo", "Bitte", "Tschüss"], "a": 0, "tr": {"es": "—¿Qué tal? —Bien, gracias.", "en": "—How are you? —Fine, thanks."}, "e": {"es": "Gut = bien", "en": "Gut = fine"}}]}, {"id": "u2", "icon": "📘", "title": {"de": "Woher kommst du?", "es": "¿De dónde eres?", "en": "Where are you from?"}, "desc": {"es": "Países, idiomas y el presente de los verbos regulares", "en": "Countries, languages and the present tense of regular verbs"}, "items": [{"q": "Ich ___ aus Spanien.", "o": ["komme", "kommen", "kommt", "kommst"], "a": 0, "tr": {"es": "Soy de España.", "en": "I'm from Spain."}, "e": {"es": "ich komme", "en": "ich komme"}}, {"q": "Woher ___ du?", "o": ["kommst", "kommen", "komme", "kommt"], "a": 0, "tr": {"es": "¿De dónde eres?", "en": "Where are you from?"}, "e": {"es": "du kommst", "en": "du kommst"}}, {"q": "Wir ___ in München.", "o": ["wohnst", "wohnt", "wohnen", "wohne"], "a": 2, "tr": {"es": "Vivimos en Múnich.", "en": "We live in Munich."}, "e": {"es": "wir wohnen", "en": "wir wohnen"}}, {"q": "Maria ___ in Wien.", "o": ["arbeite", "arbeitet", "arbeitt", "arbeiten"], "a": 1, "tr": {"es": "María trabaja en Viena.", "en": "Maria works in Vienna."}, "e": {"es": "Raíz en -t: er arbeitet.", "en": "Stem in -t: er arbeitet."}}, {"q": "___ du Deutsch?", "o": ["Sprechen", "Sprichst", "Sprechst", "Spricht"], "a": 1, "tr": {"es": "¿Hablas alemán?", "en": "Do you speak German?"}, "e": {"es": "sprechen → du sprichst", "en": "sprechen → du sprichst"}}, {"q": "Ich komme aus ___ Schweiz.", "o": ["die", "das", "den", "der"], "a": 3, "tr": {"es": "Soy de Suiza.", "en": "I'm from Switzerland."}, "e": {"es": "aus der Schweiz", "en": "aus der Schweiz"}}]}, {"id": "u3", "icon": "🧩", "title": {"de": "Zahlen und Alter", "es": "Números y edad", "en": "Numbers and age"}, "desc": {"es": "Los números, la edad, el teléfono y deletrear; el verbo haben", "en": "Numbers, age, phone numbers and spelling; the verb haben"}, "items": [{"q": "Ich ___ einen Bruder.", "o": ["hat", "habe", "haben", "hast"], "a": 1, "tr": {"es": "Tengo un hermano.", "en": "I have a brother."}, "e": {"es": "ich habe", "en": "ich habe"}}, {"q": "___ du ein Handy?", "o": ["Hast", "Habt", "Hat", "Habe"], "a": 0, "tr": {"es": "¿Tienes móvil?", "en": "Do you have a mobile?"}, "e": {"es": "du hast", "en": "du hast"}}, {"q": "Wie alt ___ du?", "o": ["bist", "hast", "bin", "ist"], "a": 0, "tr": {"es": "¿Cuántos años tienes?", "en": "How old are you?"}, "e": {"es": "La edad con sein.", "en": "Age with sein."}}, {"q": "Meine Schwester ___ zwanzig.", "o": ["bist", "habe", "ist", "hat"], "a": 2, "tr": {"es": "Mi hermana tiene veinte años.", "en": "My sister is twenty."}, "e": {"es": "La edad con sein.", "en": "Age with sein."}}, {"q": "25 = fünf___zwanzig", "o": ["und", "zehn", "-ig", "und-"], "a": 0, "tr": {"es": "veinticinco", "en": "twenty-five"}, "e": {"es": "La unidad va primero: fünfundzwanzig.", "en": "The unit comes first: fünfundzwanzig."}}]}, {"id": "u4", "icon": "🧠", "title": {"de": "Meine Familie", "es": "Mi familia", "en": "My family"}, "desc": {"es": "La familia, los posesivos y el estado civil", "en": "The family, possessives and marital status"}, "items": [{"q": "Das ist ___ Mutter.", "o": ["meinen", "meiner", "mein", "meine"], "a": 3, "tr": {"es": "Esta es mi madre.", "en": "This is my mother."}, "e": {"es": "Mutter es femenino: meine.", "en": "Mutter is feminine: meine."}}, {"q": "Das ist ___ Vater.", "o": ["meinen", "mein", "meines", "meine"], "a": 1, "tr": {"es": "Este es mi padre.", "en": "This is my father."}, "e": {"es": "Vater es masculino: mein.", "en": "Vater is masculine: mein."}}, {"q": "Peter und ___ Schwester wohnen in Köln.", "o": ["ihr", "sein", "seine", "ihre"], "a": 2, "tr": {"es": "Peter y su hermana viven en Colonia.", "en": "Peter and his sister live in Cologne."}, "e": {"es": "De él: sein / seine.", "en": "His: sein / seine."}}, {"q": "Anna und ___ Bruder spielen Tennis.", "o": ["ihre", "seine", "ihr", "sein"], "a": 2, "tr": {"es": "Anna y su hermano juegan al tenis.", "en": "Anna and her brother play tennis."}, "e": {"es": "De ella: ihr.", "en": "Her: ihr."}}, {"q": "Wie heißen ___ Kinder, Frau Klein?", "o": ["Ihr", "ihre", "Ihre", "deine"], "a": 2, "tr": {"es": "¿Cómo se llaman sus hijos, señora Klein?", "en": "What are your children called, Mrs Klein?"}, "e": {"es": "Formal: Ihre (con mayúscula).", "en": "Formal: Ihre (capital letter)."}}, {"q": "Ich habe zwei ___.", "o": ["Kinden", "Kinds", "Kind", "Kinder"], "a": 3, "tr": {"es": "Tengo dos hijos.", "en": "I have two children."}, "e": {"es": "das Kind → die Kinder", "en": "das Kind → die Kinder"}}]}, {"id": "u5", "icon": "🎯", "title": {"de": "Was ist das?", "es": "¿Qué es esto?", "en": "What is this?"}, "desc": {"es": "Objetos de clase y de casa; el artículo y el género; kein", "en": "Classroom and household objects; articles and gender; kein"}, "items": [{"q": "Das ist ___ Tisch.", "o": ["einen", "eine", "ein", "kein"], "a": 2, "tr": {"es": "Esto es una mesa.", "en": "This is a table."}, "e": {"es": "der Tisch → ein Tisch", "en": "der Tisch → ein Tisch"}}, {"q": "Das ist ___ Lampe.", "o": ["einen", "einer", "ein", "eine"], "a": 3, "tr": {"es": "Esto es una lámpara.", "en": "This is a lamp."}, "e": {"es": "die Lampe → eine Lampe", "en": "die Lampe → eine Lampe"}}, {"q": "Nein, das ist ___ Buch, das ist ein Heft.", "o": ["kein", "ein", "nicht", "keine"], "a": 0, "tr": {"es": "No, esto no es un libro, es un cuaderno.", "en": "No, this isn't a book, it's an exercise book."}, "e": {"es": "das Buch → kein Buch", "en": "das Buch → kein Buch"}}, {"q": "Ich habe ___ Fotos.", "o": ["kein", "keinen", "keine", "nicht"], "a": 2, "tr": {"es": "No tengo fotos.", "en": "I don't have any photos."}, "e": {"es": "Plural: keine.", "en": "Plural: keine."}}, {"q": "Die Uhr ist neu. ___ ist sehr schön.", "o": ["Sie", "Es", "Er", "Ihr"], "a": 0, "tr": {"es": "El reloj es nuevo. Es muy bonito.", "en": "The clock is new. It's very nice."}, "e": {"es": "die Uhr → sie", "en": "die Uhr → sie"}}, {"q": "___ Fenster ist groß.", "o": ["Die", "Der", "Das", "Den"], "a": 2, "tr": {"es": "La ventana es grande.", "en": "The window is big."}, "e": {"es": "das Fenster", "en": "das Fenster"}}]}, {"id": "u6", "icon": "🛠", "title": {"de": "Essen und Trinken", "es": "Comer y beber", "en": "Food and drink"}, "desc": {"es": "Comidas y bebidas; el acusativo; möchten y mögen; verbos con cambio de vocal", "en": "Food and drink; the accusative; möchten and mögen; verbs with a vowel change"}, "items": [{"q": "Ich möchte ___ Kaffee, bitte.", "o": ["eine", "einen", "ein", "einer"], "a": 1, "tr": {"es": "Querría un café, por favor.", "en": "I'd like a coffee, please."}, "e": {"es": "der Kaffee → einen Kaffee (acusativo)", "en": "der Kaffee → einen Kaffee (accusative)"}}, {"q": "Wir nehmen ___ Salat.", "o": ["den", "dem", "die", "der"], "a": 0, "tr": {"es": "Tomamos la ensalada.", "en": "We'll have the salad."}, "e": {"es": "der Salat → den Salat", "en": "der Salat → den Salat"}}, {"q": "Er ___ gern Fisch.", "o": ["essen", "esst", "isst", "esse"], "a": 2, "tr": {"es": "Le gusta comer pescado.", "en": "He likes eating fish."}, "e": {"es": "essen → er isst", "en": "essen → er isst"}}, {"q": "Was ___ du? Die Pizza oder die Pasta?", "o": ["nehmst", "nimmst", "nehme", "nimmt"], "a": 1, "tr": {"es": "¿Qué tomas? ¿La pizza o la pasta?", "en": "What are you having? The pizza or the pasta?"}, "e": {"es": "nehmen → du nimmst", "en": "nehmen → du nimmst"}}, {"q": "Ich mag ___ Käse.", "o": ["keine", "nicht", "kein", "keinen"], "a": 3, "tr": {"es": "No me gusta el queso.", "en": "I don't like cheese."}, "e": {"es": "der Käse → keinen Käse", "en": "der Käse → keinen Käse"}}, {"q": "___ du Tee oder Kaffee?", "o": ["Möchten", "Möchtest", "Mag", "Möchte"], "a": 1, "tr": {"es": "¿Quieres té o café?", "en": "Would you like tea or coffee?"}, "e": {"es": "du möchtest", "en": "du möchtest"}}]}, {"id": "u7", "icon": "️", "title": {"de": "Einkaufen", "es": "De compras", "en": "Shopping"}, "desc": {"es": "En el supermercado y en el mercado: precios, cantidades y envases", "en": "At the supermarket and the market: prices, quantities and packaging"}, "items": [{"q": "Was ___ der Käse?", "o": ["koste", "kostest", "kosten", "kostet"], "a": 3, "tr": {"es": "¿Cuánto cuesta el queso?", "en": "How much is the cheese?"}, "e": {"es": "Un objeto: kostet.", "en": "One thing: kostet."}}, {"q": "Die Tomaten ___ drei Euro.", "o": ["kosten", "kostet", "koste", "kostest"], "a": 0, "tr": {"es": "Los tomates cuestan tres euros.", "en": "The tomatoes cost three euros."}, "e": {"es": "Plural: kosten.", "en": "Plural: kosten."}}, {"q": "Ich brauche ein Kilo ___.", "o": ["Kartoffel", "von Kartoffeln", "der Kartoffeln", "Kartoffeln"], "a": 3, "tr": {"es": "Necesito un kilo de patatas.", "en": "I need a kilo of potatoes."}, "e": {"es": "Sin «de»: ein Kilo Kartoffeln.", "en": "No \"of\": ein Kilo Kartoffeln."}}, {"q": "Wir brauchen noch ___ Liter Milch.", "o": ["eine", "einem", "ein", "einen"], "a": 3, "tr": {"es": "Necesitamos un litro más de leche.", "en": "We need another litre of milk."}, "e": {"es": "der Liter → einen Liter", "en": "der Liter → einen Liter"}}, {"q": "Kann ich mit ___ zahlen?", "o": ["Kasse", "Geld", "Preis", "Karte"], "a": 3, "tr": {"es": "¿Puedo pagar con tarjeta?", "en": "Can I pay by card?"}, "e": {"es": "mit Karte zahlen", "en": "mit Karte zahlen"}}]}, {"id": "u8", "icon": "🔁", "title": {"de": "Mein Tag", "es": "Mi día", "en": "My day"}, "desc": {"es": "La hora, la rutina diaria y los verbos separables", "en": "Telling the time, daily routine and separable verbs"}, "items": [{"q": "Ich stehe um sechs Uhr ___.", "o": ["auf", "an", "ab", "ein"], "a": 0, "tr": {"es": "Me levanto a las seis.", "en": "I get up at six."}, "e": {"es": "auf|stehen", "en": "auf|stehen"}}, {"q": "Am Abend sehe ich ___.", "o": ["an", "zu", "auf", "fern"], "a": 3, "tr": {"es": "Por la noche veo la tele.", "en": "In the evening I watch TV."}, "e": {"es": "fern|sehen", "en": "fern|sehen"}}, {"q": "Der Kurs fängt um neun Uhr ___.", "o": ["ein", "an", "mit", "auf"], "a": 1, "tr": {"es": "El curso empieza a las nueve.", "en": "The course starts at nine."}, "e": {"es": "an|fangen", "en": "an|fangen"}}, {"q": "___ acht Uhr frühstücke ich.", "o": ["Um", "Im", "Am", "Von"], "a": 0, "tr": {"es": "A las ocho desayuno.", "en": "At eight I have breakfast."}, "e": {"es": "um + hora", "en": "um + clock time"}}, {"q": "Dann ___ ich zur Arbeit.", "o": ["fahre", "fährt", "ich fahre", "fahren"], "a": 0, "tr": {"es": "Luego voy al trabajo.", "en": "Then I go to work."}, "e": {"es": "Verbo en 2.ª posición.", "en": "Verb in second position."}}, {"q": "Es ist halb ___. (7:30)", "o": ["sieben", "sechs", "neun", "acht"], "a": 3, "tr": {"es": "Son las siete y media.", "en": "It's half past seven."}, "e": {"es": "halb acht = 7:30", "en": "halb acht = 7:30"}}]}, {"id": "u9", "icon": "📐", "title": {"de": "Freizeit und Hobbys", "es": "Tiempo libre y aficiones", "en": "Free time and hobbies"}, "desc": {"es": "Hablar de aficiones; gern, lieber, am liebsten; más verbos con cambio de vocal", "en": "Talking about hobbies; gern, lieber, am liebsten; more verbs with a vowel change"}, "items": [{"q": "Ich spiele ___ Fußball.", "o": ["gern", "gut", "am liebsten", "lieber"], "a": 0, "tr": {"es": "Me gusta jugar al fútbol.", "en": "I like playing football."}, "e": {"es": "gern = con gusto", "en": "gern = gladly"}}, {"q": "Ich lese gern, aber ich sehe ___ fern.", "o": ["gern", "liebsten", "mehr", "lieber"], "a": 3, "tr": {"es": "Me gusta leer, pero prefiero ver la tele.", "en": "I like reading, but I prefer watching TV."}, "e": {"es": "lieber = preferir", "en": "lieber = rather"}}, {"q": "Mein Bruder ___ jeden Tag Rad.", "o": ["fährt", "fahre", "fahren", "fahrt"], "a": 0, "tr": {"es": "Mi hermano va en bici todos los días.", "en": "My brother cycles every day."}, "e": {"es": "fahren → er fährt", "en": "fahren → er fährt"}}, {"q": "___ du gern Romane?", "o": ["Lest", "Lese", "Lesen", "Liest"], "a": 3, "tr": {"es": "¿Te gusta leer novelas?", "en": "Do you like reading novels?"}, "e": {"es": "lesen → du liest", "en": "lesen → du liest"}}, {"q": "Sie ___ am Wochenende lange.", "o": ["schläft", "schlafst", "schlafe", "schlaft"], "a": 0, "tr": {"es": "El fin de semana duerme mucho.", "en": "At the weekend she sleeps late."}, "e": {"es": "schlafen → sie schläft", "en": "schlafen → sie schläft"}}, {"q": "Ich tanze ___ gern.", "o": ["nicht", "keine", "kein", "nichts"], "a": 0, "tr": {"es": "No me gusta bailar.", "en": "I don't like dancing."}, "e": {"es": "nicht + gern", "en": "nicht + gern"}}]}, {"id": "u10", "icon": "🗝", "title": {"de": "Termine", "es": "Citas", "en": "Appointments"}, "desc": {"es": "Días, meses, fechas y citas; los números ordinales", "en": "Days, months, dates and appointments; ordinal numbers"}, "items": [{"q": "Ich habe ___ Montag einen Termin.", "o": ["am", "im", "an", "um"], "a": 0, "tr": {"es": "Tengo una cita el lunes.", "en": "I have an appointment on Monday."}, "e": {"es": "am + día", "en": "am + day"}}, {"q": "___ Juli fahren wir nach Italien.", "o": ["Um", "Im", "Am", "In"], "a": 1, "tr": {"es": "En julio vamos a Italia.", "en": "In July we're going to Italy."}, "e": {"es": "im + mes", "en": "im + month"}}, {"q": "Der Kurs beginnt ___ neun Uhr.", "o": ["im", "um", "am", "an"], "a": 1, "tr": {"es": "El curso empieza a las nueve.", "en": "The course begins at nine."}, "e": {"es": "um + hora", "en": "um + clock time"}}, {"q": "Heute ist der ___ März.", "o": ["erste", "ersten", "eins", "einte"], "a": 0, "tr": {"es": "Hoy es uno de marzo.", "en": "Today is the first of March."}, "e": {"es": "1. = erste", "en": "1. = erste"}}, {"q": "Mein Geburtstag ist am ___ Mai.", "o": ["drei", "dritten", "dritte", "dreiten"], "a": 1, "tr": {"es": "Mi cumpleaños es el tres de mayo.", "en": "My birthday is on the third of May."}, "e": {"es": "am + -ten: am dritten", "en": "am + -ten: am dritten"}}, {"q": "Hast du am Wochenende ___?", "o": ["Zeit", "Termin", "Uhr", "Tag"], "a": 0, "tr": {"es": "¿Tienes tiempo el fin de semana?", "en": "Are you free at the weekend?"}, "e": {"es": "Zeit haben = tener tiempo", "en": "Zeit haben = to have time"}}]}, {"id": "u11", "icon": "️", "title": {"de": "Können, wollen, müssen", "es": "Poder, querer, tener que", "en": "Can, want, must"}, "desc": {"es": "Los verbos modales y la estructura de la frase con dos verbos", "en": "Modal verbs and the sentence structure with two verbs"}, "items": [{"q": "Ich ___ gut kochen.", "o": ["kanne", "kann", "kannst", "können"], "a": 1, "tr": {"es": "Sé cocinar bien.", "en": "I can cook well."}, "e": {"es": "ich kann", "en": "ich kann"}}, {"q": "Du ___ heute die Hausaufgaben machen.", "o": ["muss", "musst", "müsst", "müssen"], "a": 1, "tr": {"es": "Hoy tienes que hacer los deberes.", "en": "You have to do your homework today."}, "e": {"es": "du musst", "en": "du musst"}}, {"q": "Wir wollen am Samstag ins Kino ___.", "o": ["gehen", "geht", "gehe", "gegangen"], "a": 0, "tr": {"es": "El sábado queremos ir al cine.", "en": "We want to go to the cinema on Saturday."}, "e": {"es": "Infinitivo al final.", "en": "Infinitive at the end."}}, {"q": "Hier ___ man nicht parken.", "o": ["darfst", "dürft", "dürfen", "darf"], "a": 3, "tr": {"es": "Aquí no se puede aparcar.", "en": "You can't park here."}, "e": {"es": "man darf nicht = prohibido", "en": "man darf nicht = not allowed"}}, {"q": "___ ihr mitkommen?", "o": ["Wollen", "Will", "Wollt", "Willst"], "a": 2, "tr": {"es": "¿Queréis venir?", "en": "Do you (all) want to come along?"}, "e": {"es": "ihr wollt", "en": "ihr wollt"}}, {"q": "Der Arzt sagt, ich ___ viel Wasser trinken.", "o": ["sollen", "will", "soll", "sollst"], "a": 2, "tr": {"es": "El médico dice que tengo que beber mucha agua.", "en": "The doctor says I should drink a lot of water."}, "e": {"es": "sollen = porque otro lo dice", "en": "sollen = because someone says so"}}]}, {"id": "u12", "icon": "🧭", "title": {"de": "Wohnen", "es": "La vivienda", "en": "Where you live"}, "desc": {"es": "La casa, las habitaciones y los muebles; describir la vivienda", "en": "The home, rooms and furniture; describing your flat"}, "items": [{"q": "Die Küche ist sehr ___. Sie hat zwei Fenster.", "o": ["hässlich", "laut", "dunkel", "hell"], "a": 3, "tr": {"es": "La cocina es muy luminosa. Tiene dos ventanas.", "en": "The kitchen is very bright. It has two windows."}, "e": {"es": "hell = luminoso", "en": "hell = bright"}}, {"q": "Im Wohnzimmer gibt es ___ Sofa.", "o": ["ein", "einem", "einen", "eine"], "a": 0, "tr": {"es": "En el salón hay un sofá.", "en": "There is a sofa in the living room."}, "e": {"es": "das Sofa → ein Sofa", "en": "das Sofa → ein Sofa"}}, {"q": "In der Küche gibt es ___ Kühlschrank.", "o": ["einen", "einer", "ein", "eine"], "a": 0, "tr": {"es": "En la cocina hay una nevera.", "en": "There is a fridge in the kitchen."}, "e": {"es": "es gibt + acusativo: einen", "en": "es gibt + accusative: einen"}}, {"q": "Die Wohnung ist schön, aber ___ teuer.", "o": ["auch", "so zu", "zu", "sehr zu"], "a": 2, "tr": {"es": "El piso es bonito, pero demasiado caro.", "en": "The flat is nice, but too expensive."}, "e": {"es": "zu = demasiado", "en": "zu = too"}}, {"q": "Wie ___ Zimmer hat das Haus?", "o": ["vieler", "viele", "vielen", "viel"], "a": 1, "tr": {"es": "¿Cuántas habitaciones tiene la casa?", "en": "How many rooms does the house have?"}, "e": {"es": "wie viele + plural", "en": "wie viele + plural"}}, {"q": "Wir wohnen im dritten ___.", "o": ["Platz", "Zimmer", "Stock", "Haus"], "a": 2, "tr": {"es": "Vivimos en el tercer piso.", "en": "We live on the third floor."}, "e": {"es": "im dritten Stock", "en": "im dritten Stock"}}]}, {"id": "u13", "icon": "⚙", "title": {"de": "In der Stadt", "es": "En la ciudad", "en": "In town"}, "desc": {"es": "Lugares de la ciudad, preguntar el camino y el imperativo", "en": "Places in town, asking the way and the imperative"}, "items": [{"q": "___ Sie hier links!", "o": ["Geht", "Gehen", "Geh", "Gehst"], "a": 1, "tr": {"es": "¡Gire aquí a la izquierda!", "en": "Turn left here!"}, "e": {"es": "Imperativo Sie: Gehen Sie", "en": "Sie imperative: Gehen Sie"}}, {"q": "___ den Bus Nummer 5, Paul!", "o": ["Nimmst", "Nehm", "Nimm", "Nehmt"], "a": 2, "tr": {"es": "¡Coge el autobús número 5, Paul!", "en": "Take bus number 5, Paul!"}, "e": {"es": "Imperativo du: nimm", "en": "du imperative: nimm"}}, {"q": "Die Apotheke ist neben ___ Bank.", "o": ["der", "dem", "den", "die"], "a": 0, "tr": {"es": "La farmacia está al lado del banco.", "en": "The chemist's is next to the bank."}, "e": {"es": "die → der (dativo)", "en": "die → der (dative)"}}, {"q": "Wir treffen uns ___ Park.", "o": ["in", "am", "in die", "im"], "a": 3, "tr": {"es": "Quedamos en el parque.", "en": "We're meeting in the park."}, "e": {"es": "in + dem = im", "en": "in + dem = im"}}, {"q": "Das Hotel ist gegenüber ___ Bahnhof.", "o": ["dem", "den", "der", "das"], "a": 0, "tr": {"es": "El hotel está enfrente de la estación.", "en": "The hotel is opposite the station."}, "e": {"es": "der → dem (dativo)", "en": "der → dem (dative)"}}, {"q": "Gehen Sie hier ___ und dann rechts.", "o": ["links", "weit", "geradeaus", "gerade"], "a": 2, "tr": {"es": "Siga recto y luego a la derecha.", "en": "Go straight on and then right."}, "e": {"es": "geradeaus = todo recto", "en": "geradeaus = straight on"}}]}, {"id": "u14", "icon": "️", "title": {"de": "Unterwegs", "es": "De viaje por la ciudad", "en": "Getting around"}, "desc": {"es": "Los medios de transporte, los billetes y las preposiciones con dativo", "en": "Means of transport, tickets and prepositions with the dative"}, "items": [{"q": "Ich fahre mit ___ Bus zur Arbeit.", "o": ["den", "das", "dem", "der"], "a": 2, "tr": {"es": "Voy al trabajo en autobús.", "en": "I go to work by bus."}, "e": {"es": "mit + dativo: dem Bus", "en": "mit + dative: dem Bus"}}, {"q": "Sie fährt mit ___ U-Bahn.", "o": ["die", "der", "den", "dem"], "a": 1, "tr": {"es": "Va en metro.", "en": "She goes by underground."}, "e": {"es": "die → der (dativo)", "en": "die → der (dative)"}}, {"q": "Ich gehe jetzt ___ Arzt.", "o": ["zum", "nach", "zur", "beim"], "a": 0, "tr": {"es": "Ahora voy al médico.", "en": "I'm going to the doctor's now."}, "e": {"es": "zu + dem = zum", "en": "zu + dem = zum"}}, {"q": "Wie komme ich ___ Universität?", "o": ["zu", "nach", "zum", "zur"], "a": 3, "tr": {"es": "¿Cómo llego a la universidad?", "en": "How do I get to the university?"}, "e": {"es": "zu + der = zur", "en": "zu + der = zur"}}, {"q": "Der Zug fährt um acht Uhr ___.", "o": ["um", "aus", "ab", "an"], "a": 2, "tr": {"es": "El tren sale a las ocho.", "en": "The train leaves at eight."}, "e": {"es": "ab|fahren", "en": "ab|fahren"}}, {"q": "In Köln müssen Sie ___.", "o": ["umsteigt", "umsteigen", "umstiegen", "steigen um"], "a": 1, "tr": {"es": "En Colonia tiene que hacer transbordo.", "en": "You have to change in Cologne."}, "e": {"es": "Modal + infinitivo al final.", "en": "Modal + infinitive at the end."}}]}, {"id": "u15", "icon": "🪄", "title": {"de": "Kleidung", "es": "La ropa", "en": "Clothes"}, "desc": {"es": "La ropa, los colores, gustar y los pronombres en acusativo", "en": "Clothes, colours, gefallen and accusative pronouns"}, "items": [{"q": "Der Pullover ___ mir.", "o": ["gefallen", "gefällst", "gefalle", "gefällt"], "a": 3, "tr": {"es": "Me gusta el jersey.", "en": "I like the jumper."}, "e": {"es": "Un objeto: gefällt.", "en": "One thing: gefällt."}}, {"q": "Die Schuhe ___ mir nicht.", "o": ["gefallen", "gefalle", "gefallt", "gefällt"], "a": 0, "tr": {"es": "No me gustan los zapatos.", "en": "I don't like the shoes."}, "e": {"es": "Plural: gefallen.", "en": "Plural: gefallen."}}, {"q": "Gefällt ___ das Kleid, Lisa?", "o": ["dich", "du", "mir", "dir"], "a": 3, "tr": {"es": "¿Te gusta el vestido, Lisa?", "en": "Do you like the dress, Lisa?"}, "e": {"es": "Dativo de du: dir", "en": "Dative of du: dir"}}, {"q": "Der Mantel ist schön. Ich kaufe ___.", "o": ["ihn", "es", "sie", "er"], "a": 0, "tr": {"es": "El abrigo es bonito. Me lo compro.", "en": "The coat is nice. I'll buy it."}, "e": {"es": "der Mantel → ihn", "en": "der Mantel → ihn"}}, {"q": "Die Jacke ist zu klein. Ich nehme ___ nicht.", "o": ["ihr", "es", "ihn", "sie"], "a": 3, "tr": {"es": "La chaqueta es demasiado pequeña. No me la llevo.", "en": "The jacket is too small. I won't take it."}, "e": {"es": "die Jacke → sie", "en": "die Jacke → sie"}}, {"q": "___ Hemd möchtest du?", "o": ["Welches", "Welchen", "Welche", "Welcher"], "a": 0, "tr": {"es": "¿Qué camisa quieres?", "en": "Which shirt would you like?"}, "e": {"es": "das Hemd → welches", "en": "das Hemd → welches"}}]}, {"id": "u16", "icon": "📎", "title": {"de": "Der Körper und die Gesundheit", "es": "El cuerpo y la salud", "en": "The body and health"}, "desc": {"es": "Las partes del cuerpo, decir qué te duele e ir al médico", "en": "Parts of the body, saying what hurts and going to the doctor"}, "items": [{"q": "Mein Kopf ___ weh.", "o": ["tue", "tut", "tun", "tust"], "a": 1, "tr": {"es": "Me duele la cabeza.", "en": "My head hurts."}, "e": {"es": "Singular: tut weh.", "en": "Singular: tut weh."}}, {"q": "Meine Füße ___ weh.", "o": ["tust", "tun", "tue", "tut"], "a": 1, "tr": {"es": "Me duelen los pies.", "en": "My feet hurt."}, "e": {"es": "Plural: tun weh.", "en": "Plural: tun weh."}}, {"q": "Ich habe ___. Mein Hals tut weh.", "o": ["Halsschmerzen", "Hals", "Fieber", "Kopf"], "a": 0, "tr": {"es": "Me duele la garganta.", "en": "I have a sore throat."}, "e": {"es": "Hals + Schmerzen", "en": "Hals + Schmerzen"}}, {"q": "___ Sie viel Wasser!", "o": ["Trinkt", "Trinken", "Trinkst", "Trink"], "a": 1, "tr": {"es": "¡Beba mucha agua!", "en": "Drink plenty of water!"}, "e": {"es": "Imperativo Sie", "en": "Sie imperative"}}, {"q": "Der Arzt sagt, ich ___ zu Hause bleiben.", "o": ["sollst", "sollen", "will", "soll"], "a": 3, "tr": {"es": "El médico dice que tengo que quedarme en casa.", "en": "The doctor says I should stay at home."}, "e": {"es": "sollen = consejo de otro", "en": "sollen = someone else's advice"}}, {"q": "Ich habe zwei Hände und zehn ___.", "o": ["Fingern", "Fingeren", "Finger", "Fingers"], "a": 2, "tr": {"es": "Tengo dos manos y diez dedos.", "en": "I have two hands and ten fingers."}, "e": {"es": "der Finger → die Finger", "en": "der Finger → die Finger"}}]}, {"id": "u17", "icon": "🧱", "title": {"de": "Das Wetter", "es": "El tiempo", "en": "The weather"}, "desc": {"es": "El tiempo, las estaciones y los verbos impersonales con es", "en": "The weather, the seasons and impersonal verbs with es"}, "items": [{"q": "Heute ___ es. Wir brauchen einen Schirm.", "o": ["Regen", "regnen", "regnet", "regne"], "a": 2, "tr": {"es": "Hoy llueve. Necesitamos un paraguas.", "en": "It's raining today. We need an umbrella."}, "e": {"es": "es regnet", "en": "es regnet"}}, {"q": "Die Sonne ___.", "o": ["scheint", "scheine", "scheinen", "sonnig"], "a": 0, "tr": {"es": "Hace sol.", "en": "The sun is shining."}, "e": {"es": "die Sonne scheint", "en": "die Sonne scheint"}}, {"q": "___ Winter ist es kalt.", "o": ["Um", "In", "Im", "Am"], "a": 2, "tr": {"es": "En invierno hace frío.", "en": "It's cold in winter."}, "e": {"es": "im + estación", "en": "im + season"}}, {"q": "Wie ist das ___ in Berlin?", "o": ["Grad", "Wetter", "Sonne", "Wind"], "a": 1, "tr": {"es": "¿Qué tiempo hace en Berlín?", "en": "What's the weather like in Berlin?"}, "e": {"es": "das Wetter", "en": "das Wetter"}}, {"q": "Es sind dreißig ___.", "o": ["Uhr", "Grade", "Grads", "Grad"], "a": 3, "tr": {"es": "Hace treinta grados.", "en": "It's thirty degrees."}, "e": {"es": "Grad no lleva plural.", "en": "Grad has no plural."}}, {"q": "___ ist kalt. Kannst du das Fenster schließen?", "o": ["Mich", "Mir", "Ich", "Mein"], "a": 1, "tr": {"es": "Tengo frío. ¿Puedes cerrar la ventana?", "en": "I'm cold. Can you close the window?"}, "e": {"es": "mir ist kalt = tengo frío", "en": "mir ist kalt = I'm cold"}}]}, {"id": "u18", "icon": "🔍", "title": {"de": "Was hast du gemacht?", "es": "¿Qué has hecho?", "en": "What did you do?"}, "desc": {"es": "Contar lo que hiciste: el Perfekt con haben", "en": "Saying what you did: the Perfekt with haben"}, "items": [{"q": "Ich ___ gestern Tennis gespielt.", "o": ["haben", "habe", "hat", "bin"], "a": 1, "tr": {"es": "Ayer jugué al tenis.", "en": "I played tennis yesterday."}, "e": {"es": "ich habe … gespielt", "en": "ich habe … gespielt"}}, {"q": "Wir haben Pizza ___.", "o": ["gegessen", "essen", "geesst", "gegesst"], "a": 0, "tr": {"es": "Hemos comido pizza.", "en": "We had pizza."}, "e": {"es": "essen → gegessen", "en": "essen → gegessen"}}, {"q": "Hast du den Film ___?", "o": ["gesehen", "sehen", "geseht", "gesieht"], "a": 0, "tr": {"es": "¿Has visto la película?", "en": "Have you seen the film?"}, "e": {"es": "sehen → gesehen", "en": "sehen → gesehen"}}, {"q": "Sie hat bis 18 Uhr ___.", "o": ["gearbeit", "arbeitet", "gearbeitt", "gearbeitet"], "a": 3, "tr": {"es": "Ha trabajado hasta las seis.", "en": "She worked until six."}, "e": {"es": "arbeiten → gearbeitet", "en": "arbeiten → gearbeitet"}}, {"q": "Am Wochenende haben wir meine Oma ___.", "o": ["besucht", "gesucht", "gebesucht", "besuchen"], "a": 0, "tr": {"es": "El fin de semana visitamos a mi abuela.", "en": "At the weekend we visited my grandma."}, "e": {"es": "be-: sin ge-", "en": "be-: no ge-"}}, {"q": "Er hat in Berlin Medizin ___.", "o": ["gestudiert", "studieren", "studiert", "gestudieren"], "a": 2, "tr": {"es": "Estudió medicina en Berlín.", "en": "He studied medicine in Berlin."}, "e": {"es": "-ieren: sin ge-", "en": "-ieren: no ge-"}}]}, {"id": "u19", "icon": "📝", "title": {"de": "Am Wochenende", "es": "El fin de semana", "en": "At the weekend"}, "desc": {"es": "Más Perfekt: con sein; el pasado de sein y haben", "en": "More Perfekt: with sein; the past of sein and haben"}, "items": [{"q": "Wir ___ nach Wien gefahren.", "o": ["ist", "haben", "hat", "sind"], "a": 3, "tr": {"es": "Fuimos a Viena.", "en": "We went to Vienna."}, "e": {"es": "fahren (de A a B): sein", "en": "fahren (from A to B): sein"}}, {"q": "Ich bin um sieben Uhr ___.", "o": ["aufgesteht", "aufstehen", "aufgestanden", "geaufstanden"], "a": 2, "tr": {"es": "Me levanté a las siete.", "en": "I got up at seven."}, "e": {"es": "auf|stehen → aufgestanden", "en": "auf|stehen → aufgestanden"}}, {"q": "Er ist nach Mallorca ___.", "o": ["geflogen", "gefliegt", "fliegen", "geflogt"], "a": 0, "tr": {"es": "Voló a Mallorca.", "en": "He flew to Mallorca."}, "e": {"es": "fliegen → geflogen", "en": "fliegen → geflogen"}}, {"q": "Gestern ___ ich krank.", "o": ["hatte", "war", "bin", "ist"], "a": 1, "tr": {"es": "Ayer estuve enfermo.", "en": "I was ill yesterday."}, "e": {"es": "sein → war", "en": "sein → war"}}, {"q": "Wir ___ keine Zeit.", "o": ["hatten", "hatte", "waren", "hattet"], "a": 0, "tr": {"es": "No teníamos tiempo.", "en": "We didn't have time."}, "e": {"es": "haben → wir hatten", "en": "haben → wir hatten"}}, {"q": "Wo ___ du am Wochenende?", "o": ["war", "waren", "warst", "wart"], "a": 2, "tr": {"es": "¿Dónde estuviste el fin de semana?", "en": "Where were you at the weekend?"}, "e": {"es": "du warst", "en": "du warst"}}]}, {"id": "u20", "icon": "🎓", "title": {"de": "Im Hotel", "es": "En el hotel", "en": "At the hotel"}, "desc": {"es": "Reservar y alojarse en un hotel; escribir un correo; und, aber, oder, denn", "en": "Booking and staying at a hotel; writing an email; und, aber, oder, denn"}, "items": [{"q": "Haben Sie noch ein ___ frei? Ich bin allein.", "o": ["Hotel", "Einzelzimmer", "Doppelzimmer", "Bad"], "a": 1, "tr": {"es": "¿Le queda una habitación individual? Voy solo.", "en": "Do you have a single room free? I'm on my own."}, "e": {"es": "allein → Einzelzimmer", "en": "alone → Einzelzimmer"}}, {"q": "Das Zimmer ist schön, ___ es ist laut.", "o": ["aber", "und", "denn", "oder"], "a": 0, "tr": {"es": "La habitación es bonita, pero hay ruido.", "en": "The room is nice, but it's noisy."}, "e": {"es": "aber = pero", "en": "aber = but"}}, {"q": "Ich bleibe zu Hause, ___ ich bin krank.", "o": ["aber", "oder", "dann", "denn"], "a": 3, "tr": {"es": "Me quedo en casa porque estoy enfermo.", "en": "I'm staying at home because I'm ill."}, "e": {"es": "denn = porque (orden normal)", "en": "denn = because (normal order)"}}, {"q": "Ich ___ gern ein Zimmer mit Balkon.", "o": ["möchte", "hätte", "hatte", "habe gern"], "a": 1, "tr": {"es": "Querría una habitación con balcón.", "en": "I'd like a room with a balcony."}, "e": {"es": "Ich hätte gern… = querría", "en": "Ich hätte gern… = I'd like"}}, {"q": "Wir bleiben ___ 3. bis zum 7. Juni.", "o": ["von", "am", "vom", "im"], "a": 2, "tr": {"es": "Nos quedamos del 3 al 7 de junio.", "en": "We're staying from the 3rd to the 7th of June."}, "e": {"es": "vom … bis zum", "en": "vom … bis zum"}}, {"q": "Sehr ___ Damen und Herren,", "o": ["geehrter", "geehrte", "gute", "liebe"], "a": 1, "tr": {"es": "Estimados señores:", "en": "Dear Sir or Madam,"}, "e": {"es": "Sehr geehrte Damen und Herren", "en": "Sehr geehrte Damen und Herren"}}]}]